---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Gallery from '../components/Gallery.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import { torneriaGallery } from '../data/galleries';

const trabajos = [
  {
    icon: 'settings' as const,
    title: 'Pasadores y bujes',
    text: 'El juego que más se desgasta en el equipo, fabricado con la medida original.',
  },
  {
    icon: 'tool' as const,
    title: 'Ejes y seguros',
    text: 'Torneado de ejes, casquillos y seguros a partir de la pieza o del plano.',
  },
  {
    icon: 'bolt' as const,
    title: 'Copia desde muestra',
    text: 'Si la pieza ya no se fabrica, la reproducimos tomando las medidas de la tuya.',
  },
  {
    icon: 'circle-check' as const,
    title: 'Ajuste y rectificado',
    text: 'Recuperamos piezas gastadas cuando reemplazarlas completas no tiene sentido.',
  },
];
---

<Layout
  title="Tornería — Piezas a medida"
  description="Tornería en Reyso: pasadores, bujes, ejes y seguros fabricados a medida a partir de la pieza original o del plano."
>
  <PageHero eyebrow="Piezas a medida" title="Tornería" crumb="Tornería">
    Fabricamos la pieza que no se consigue. Trabajamos a partir de tu muestra o de un plano, con la
    tolerancia que el conjunto necesita.
  </PageHero>

  <!-- ==================== QUÉ HACEMOS ==================== -->
  <section class="py-20 lg:py-24">
    <div class="container-page">
      <SectionHeading eyebrow="Trabajos habituales" title="Qué sale del torno">
        No fabricamos en serie: cada pieza se hace para el equipo que la necesita.
      </SectionHeading>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          trabajos.map((item, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
              class="flex flex-col gap-4 rounded-2xl border border-white/8 bg-ink-900/60 p-6 transition-colors duration-300 hover:border-brand-400/30"
            >
              <span class="flex size-12 items-center justify-center rounded-xl bg-brand-400/12 text-brand-400">
                <Icon name={item.icon} class="size-6" />
              </span>
              <h3 class="text-xl uppercase">{item.title}</h3>
              <p class="text-sm leading-relaxed text-ink-400">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== GALERÍA ==================== -->
  <section class="border-t border-white/8 bg-ink-900/40 py-20 lg:py-24">
    <div class="container-page">
      <SectionHeading eyebrow="Galería" title="Ejemplos de trabajos">
        Incluye un video del torno en funcionamiento. Haz clic para verlo en grande.
      </SectionHeading>

      <Gallery items={torneriaGallery} class="mt-12" />
    </div>
  </section>

  <ContactCTA
    title="¿Necesitas una pieza?"
    text="Mándanos una foto de la pieza con una medida de referencia y te decimos si podemos fabricarla."
    waMessage="Hola Reyso, necesito fabricar una pieza en torno."
  />
</Layout>
