---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { services, waLink } from '../data/site';

import heroImg from '../assets/img/easycarp.png';
import easycarpImg from '../assets/img/vistaeasycarp.jpg';
import torneriaImg from '../assets/img/torneria.png';

/* Cada servicio con su foto de portada. */
const serviceCards = [
  {
    service: services[0],
    image: easycarpImg,
    alt: 'Brazo del encarpe Easycarp extendido sobre una tolva',
  },
  {
    service: services[1],
    image: torneriaImg,
    alt: 'Pieza montada en el plato de tres mordazas de un torno',
  },
];

const marquee = [
  'Tolvas bidireccionales',
  'Doble puente',
  'Bateas',
  'Resortes americanos',
  'Pasadores y bujes',
  'Ejes a medida',
  'Piezas desde muestra',
  'Repuestos Easycarp',
];

const razones = [
  {
    icon: 'truck' as const,
    title: 'Pensado para el camión',
    text: 'Trabajamos sobre tolvas y bateas reales, no sobre catálogos. El equipo se adapta al que ya tienes.',
  },
  {
    icon: 'settings' as const,
    title: 'Piezas a medida',
    text: 'Si la pieza original no se consigue, la fabricamos en el torno a partir de la muestra.',
  },
  {
    icon: 'bolt' as const,
    title: 'Respuesta rápida',
    text: 'Cotizamos por WhatsApp con una foto. Sin formularios eternos ni esperas de días.',
  },
  {
    icon: 'circle-check' as const,
    title: 'Materiales que aguantan',
    text: 'Resortes americanos y acero de calidad. El equipo tiene que durar la temporada completa.',
  },
];

const pasos = [
  {
    n: '01',
    title: 'Nos cuentas',
    text: 'Mándanos una foto del equipo o la pieza por WhatsApp y explícanos qué necesitas.',
  },
  {
    n: '02',
    title: 'Cotizamos',
    text: 'Revisamos medidas y materiales, y te pasamos precio y plazo sin compromiso.',
  },
  {
    n: '03',
    title: 'Fabricamos e instalamos',
    text: 'Trabajamos en nuestro taller de Peñalolén: nos traes el equipo y te lo entregamos listo.',
  },
];
---

<Layout title="Reyso">
  <!-- ==================== HERO ==================== -->
  <section class="relative overflow-hidden">
    <div class="grid-texture absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div
      class="absolute top-0 -right-40 h-[32rem] w-[32rem] rounded-full bg-brand-400/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Texto -->
        <div class="flex flex-col items-start gap-7">
          <span
            data-reveal
            class="inline-flex items-center gap-2.5 rounded-full border border-brand-400/30 bg-brand-400/10 px-4 py-1.5 text-xs font-bold tracking-[0.16em] text-brand-400 uppercase"
          >
            <span class="flex size-1.5 rounded-full bg-brand-400"></span>
            Taller mecánico e industrial
          </span>

          <h1
            data-reveal
            style="--reveal-delay:70ms"
            class="text-5xl uppercase sm:text-6xl lg:text-7xl"
          >
            Encarpe y
            <span class="text-brand-400 italic">tornería</span>
            para camiones
          </h1>

          <p
            data-reveal
            style="--reveal-delay:140ms"
            class="max-w-xl text-lg leading-relaxed text-ink-300"
          >
            En <strong class="font-semibold text-white">Reyso</strong> fabricamos e instalamos el sistema
            de encarpe manual <strong class="font-semibold text-brand-400">Easycarp</strong> para tolvas
            y bateas, y fabricamos en torno las piezas que tu equipo necesita.
          </p>

          <div data-reveal style="--reveal-delay:210ms" class="flex flex-col gap-3 sm:flex-row">
            <Button
              href={waLink('Hola Reyso, quiero cotizar un trabajo.')}
              size="lg"
              icon="whatsapp"
              external
            >
              Cotizar ahora
            </Button>
            <Button href="#servicios" variant="secondary" size="lg" icon="arrow-right" iconRight>
              Ver servicios
            </Button>
          </div>

          <ul
            data-reveal
            style="--reveal-delay:280ms"
            class="flex flex-wrap gap-x-6 gap-y-2 pt-2 text-sm text-ink-400"
          >
            {
              [
                'Cotización sin costo',
                'Instalación incluida',
                'Trabajos a medida',
                'Taller en Peñalolén',
              ].map((item) => (
                <li class="flex items-center gap-2">
                  <Icon name="check" class="size-4 text-brand-400" stroke={2.5} />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Imagen -->
        <div data-reveal style="--reveal-delay:120ms" class="relative">
          <div
            class="relative overflow-hidden rounded-3xl border border-white/10 shadow-2xl shadow-black/60"
          >
            <Image
              src={heroImg}
              alt="Camión tolva con el sistema de encarpe Easycarp instalado"
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              loading="eager"
              class="aspect-[4/5] w-full object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-ink-950/70 via-transparent to-transparent"
            >
            </div>
          </div>

          <!-- Tarjeta flotante -->
          <div
            class="absolute -bottom-5 -left-3 flex items-center gap-3 rounded-2xl border border-white/10 bg-ink-900/95 px-5 py-4 shadow-xl backdrop-blur-sm sm:-left-6"
          >
            <span
              class="flex size-11 items-center justify-center rounded-xl bg-brand-500 text-white"
            >
              <Icon name="truck" class="size-6" />
            </span>
            <span class="leading-tight">
              <span class="block font-display text-lg tracking-wide text-white uppercase">
                Easycarp
              </span>
              <span class="block text-xs text-ink-400">Encarpe manual instalado</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Cinta de especialidades -->
    <div class="relative border-y border-white/8 bg-ink-900/60 py-4">
      <div class="flex overflow-hidden" aria-hidden="true">
        <ul
          class="flex shrink-0 animate-marquee items-center gap-10 pr-10 motion-reduce:animate-none"
        >
          {
            [...marquee, ...marquee].map((item) => (
              <li class="flex shrink-0 items-center gap-10 font-display text-sm tracking-[0.2em] whitespace-nowrap text-ink-400 uppercase">
                {item}
                <span class="size-1.5 rotate-45 bg-brand-400" />
              </li>
            ))
          }
        </ul>
      </div>
      <p class="sr-only">Especialidades: {marquee.join(', ')}.</p>
    </div>
  </section>

  <!-- ==================== SERVICIOS ==================== -->
  <section id="servicios" class="scroll-mt-24 py-20 lg:py-28">
    <div class="container-page">
      <SectionHeading eyebrow="Lo que hacemos" title="Dos servicios, un solo taller">
        Desde el encarpe completo del camión hasta la pieza que no se consigue en ninguna parte.
      </SectionHeading>

      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
        {
          serviceCards.map((card, i) => (
            <ServiceCard service={card.service} image={card.image} alt={card.alt} index={i} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== POR QUÉ REYSO ==================== -->
  <section class="relative overflow-hidden border-y border-white/8 bg-ink-900 py-20 lg:py-28">
    <div class="grid-texture absolute inset-0 opacity-50" aria-hidden="true"></div>

    <div class="container-page relative">
      <SectionHeading
        eyebrow="Por qué Reyso"
        title="Trabajo de taller, no de catálogo"
        align="center"
      >
        Somos un equipo chico y eso se nota: hablas directo con quien va a hacer el trabajo.
      </SectionHeading>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          razones.map((razon, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
              class="flex flex-col gap-4 rounded-2xl border border-white/8 bg-ink-950/50 p-6 transition-colors duration-300 hover:border-brand-400/30"
            >
              <span class="flex size-12 items-center justify-center rounded-xl bg-brand-400/12 text-brand-400">
                <Icon name={razon.icon} class="size-6" />
              </span>
              <h3 class="text-xl uppercase">{razon.title}</h3>
              <p class="text-sm leading-relaxed text-ink-400">{razon.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== CÓMO TRABAJAMOS ==================== -->
  <section class="py-20 lg:py-28">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeading eyebrow="Cómo trabajamos" title="De la foto al equipo instalado">
            Tres pasos, sin vueltas. La mayoría de las cotizaciones sale el mismo día.
          </SectionHeading>

          <div data-reveal class="mt-8">
            <Button
              href={waLink('Hola Reyso, tengo una consulta sobre un trabajo.')}
              icon="whatsapp"
              external
            >
              Empezar por WhatsApp
            </Button>
          </div>
        </div>

        <ol class="flex flex-col gap-4 lg:col-span-7">
          {
            pasos.map((paso, i) => (
              <li
                data-reveal
                style={`--reveal-delay:${i * 90}ms`}
                class="group flex gap-5 rounded-2xl border border-white/8 bg-ink-900/60 p-6 transition-colors duration-300 hover:border-brand-400/30"
              >
                <span class="font-display text-4xl leading-none font-bold text-brand-400/35 transition-colors duration-300 group-hover:text-brand-400">
                  {paso.n}
                </span>
                <span>
                  <h3 class="text-xl uppercase">{paso.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink-400">{paso.text}</p>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
