---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { Service } from '../data/site';

interface Props {
  service: Service;
  image: ImageMetadata;
  alt: string;
  index?: number;
}

const { service, image, alt, index = 0 } = Astro.props;
---

<article
  data-reveal
  style={`--reveal-delay:${index * 90}ms`}
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-ink-900 transition-all duration-300 hover:-translate-y-1 hover:border-brand-400/40 hover:shadow-2xl hover:shadow-black/50 focus-within:border-brand-400/40"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <Image
      src={image}
      alt={alt}
      widths={[400, 700, 1000]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/25 to-transparent"></div>

    <span
      class="absolute top-4 left-4 rounded-full bg-ink-950/80 px-3 py-1 text-[11px] font-bold tracking-[0.14em] text-brand-400 uppercase backdrop-blur-sm"
    >
      {service.short}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-4 p-6">
    <h3 class="text-2xl uppercase">
      <!-- El enlace cubre toda la tarjeta, no solo la imagen -->
      <a href={service.href} class="after:absolute after:inset-0 after:content-['']">
        {service.title}
      </a>
    </h3>

    <p class="text-sm leading-relaxed text-ink-300">{service.description}</p>

    <ul class="mt-auto flex flex-col gap-2 pt-2">
      {
        service.bullets.map((bullet) => (
          <li class="flex items-center gap-2 text-sm text-ink-200">
            <Icon name="check" class="size-4 shrink-0 text-brand-400" stroke={2.5} />
            {bullet}
          </li>
        ))
      }
    </ul>

    <span
      class="mt-2 inline-flex items-center gap-2 text-sm font-bold tracking-wide text-brand-400 uppercase"
    >
      Ver detalle
      <Icon
        name="arrow-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-1.5"
      />
    </span>
  </div>
</article>
