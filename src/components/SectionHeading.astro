---
interface Props {
  /** Texto pequeño en ámbar sobre el título. */
  eyebrow?: string;
  title: string;
  /** Alineación del bloque. */
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, align = 'left', class: className = '' } = Astro.props;
---

<div
  data-reveal
  class:list={[
    'flex flex-col gap-4',
    align === 'center' ? 'items-center text-center' : 'items-start',
    className,
  ]}
>
  {
    eyebrow && (
      <span class="inline-flex items-center gap-2.5 text-xs font-bold tracking-[0.18em] text-brand-400 uppercase">
        <span class="h-px w-7 bg-brand-400" />
        {eyebrow}
      </span>
    )
  }

  <h2 class="max-w-3xl text-4xl uppercase sm:text-5xl lg:text-6xl">{title}</h2>

  {
    Astro.slots.has('default') && (
      <p class="max-w-2xl text-base leading-relaxed text-ink-300 sm:text-lg">
        <slot />
      </p>
    )
  }
</div>
