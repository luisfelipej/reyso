---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  icon?: IconName;
  /** Coloca el icono a la derecha del texto. */
  iconRight?: boolean;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconRight = false,
  external = false,
  class: className = '',
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2.5 rounded-xl font-semibold transition-all duration-200 active:scale-[.98]';

const variants = {
  primary: 'bg-brand-500 text-white hover:bg-brand-600 hover:shadow-lg hover:shadow-brand-500/30',
  secondary: 'border border-white/15 bg-white/5 text-white hover:border-white/30 hover:bg-white/10',
  ghost: 'text-ink-200 hover:text-brand-400',
};

const sizes = {
  md: 'px-5 py-3 text-sm',
  lg: 'px-7 py-4 text-base',
};

const iconSize = size === 'lg' ? 'size-5' : 'size-4';
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class:list={[base, variants[variant], sizes[size], className]}
>
  {icon && !iconRight && <Icon name={icon} class={iconSize} />}
  <slot />
  {
    icon && iconRight && (
      <Icon
        name={icon}
        class={`${iconSize} transition-transform duration-200 group-hover:translate-x-1`}
      />
    )
  }
</a>
