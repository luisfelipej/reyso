---
import Icon from './Icon.astro';

/** Encabezado compacto para las páginas interiores. */
interface Props {
  eyebrow: string;
  title: string;
  /** Migas de pan: la última es la página actual. */
  crumb?: string;
}

const { eyebrow, title, crumb } = Astro.props;
---

<section class="relative overflow-hidden border-b border-white/8 bg-ink-900">
  <div class="grid-texture absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div
    class="absolute -top-40 left-1/3 h-72 w-[30rem] rounded-full bg-brand-400/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative py-14 lg:py-20">
    {
      crumb && (
        <nav aria-label="Ruta" class="mb-6 flex items-center gap-2 text-xs text-ink-500">
          <a href="/" class="transition-colors hover:text-brand-400">
            Inicio
          </a>
          <Icon name="chevron-right" class="size-3.5" />
          <span class="text-ink-300">{crumb}</span>
        </nav>
      )
    }

    <span
      data-reveal
      class="inline-flex items-center gap-2.5 text-xs font-bold tracking-[0.18em] text-brand-400 uppercase"
    >
      <span class="h-px w-7 bg-brand-400"></span>
      {eyebrow}
    </span>

    <h1
      data-reveal
      style="--reveal-delay:60ms"
      class="mt-5 text-5xl uppercase sm:text-6xl lg:text-7xl"
    >
      {title}
    </h1>

    {
      Astro.slots.has('default') && (
        <p
          data-reveal
          style="--reveal-delay:120ms"
          class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-300"
        >
          <slot />
        </p>
      )
    }
  </div>
</section>
